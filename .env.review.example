# Copy this file to .env.review and fill in the REVIEW agent's own separate
# GitHub identity (a second, bot/collaborator account — see docs/PIPELINE.md).
# .env.review is gitignored, same as .env.
#
# This overrides only the GitHub identity on top of the shared .env (LLM
# provider keys still come from .env) — see docker-compose.yml's
# agent-review service, which lists env_file: [.env, .env.review] in that
# order so this file's values win.

GITHUB_TOKEN=
GITHUB_USERNAME=
