# Copy this file to .env and fill in real values. .env is gitignored.
# See docs/LLM_PROVIDERS.md and docs/GITHUB_TOKEN.md for how to obtain these.

# --- Target repo: the project the agent actually develops --- docs/SETUP.md
# Absolute path on the host to the repo you want worked on. This repo
# (ai-factory) is only the container/tooling definition; TARGET_REPO_PATH is
# bind-mounted as /workspace inside the container.
TARGET_REPO_PATH=

# --- LLM providers (at least one required) --- docs/LLM_PROVIDERS.md
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GitHub access for the agent (git push, gh pr create, ...) --- docs/GITHUB_TOKEN.md
GITHUB_TOKEN=
GITHUB_USERNAME=
