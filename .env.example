# Copy this file to .env and fill in real values. .env is gitignored.
# See docs/LLM_PROVIDERS.md and docs/GITHUB_TOKEN.md for how to obtain these.

# --- LLM providers (at least one required) --- docs/LLM_PROVIDERS.md
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GitHub access for the agent (git push, gh pr create, ...) --- docs/GITHUB_TOKEN.md
GITHUB_TOKEN=
GITHUB_USERNAME=
